# Flutter/Dart build artifacts are handled by app/.gitignore (generated by
# `flutter create`). Only repo-wide concerns live here.

# Env secrets — never commit real keys
app/env/dev.json
app/env/prod.json
app/env/*.local.json
supabase/.env.local

# Supabase local dev
supabase/.branches/
supabase/.temp/

# IDE
.idea/
*.iml
.vscode/

# Claude Code local (machine-specific permissions)
.claude/settings.local.json
